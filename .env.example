# 复制本文件为 .env 后填写真实值，.env 不要提交到 git

# MySQL root 密码（首次启动后无法通过此变量修改，需进容器改）
DB_PASSWORD=change-me-in-production

# PgVector 向量数据库密码（RAG语义检索）
PG_PASSWORD=change-me-in-production

# JWT 签名密钥，生产环境务必修改为随机长字符串
JWT_SECRET=change-me-in-production

# AI 服务配置（支持任何兼容 OpenAI 协议的平台）
# 默认硅基流动；如用 DeepSeek 官方，改成下面的注释值
AI_BASE_URL=https://api.siliconflow.cn
AI_MODEL=deepseek-ai/DeepSeek-V3
# DeepSeek 官方配置：
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
AI_API_KEY=sk-你的真实key

# Embedding 向量配置（RAG 语义检索用；SiliconFlow 平台与 AI 对话可共用同一 key）
EMBEDDING_API_KEY=sk-你的真实key
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
