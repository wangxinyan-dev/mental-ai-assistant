# 复制本文件为 .env 后填写真实值，.env 不要提交到 git

# MySQL root 密码（首次启动后无法通过此变量修改，需进容器改）
DB_PASSWORD=change-me-in-production

# PgVector 向量数据库密码（RAG语义检索）
PG_PASSWORD=change-me-in-production

# JWT 签名密钥，生产环境务必修改为随机长字符串
JWT_SECRET=change-me-in-production

# AI 服务配置（支持任何兼容 OpenAI 协议的平台）
# 默认硅基流动；如用 DeepSeek 官方，改成下面的注释值
AI_BASE_URL=https://api.siliconflow.cn
AI_MODEL=deepseek-ai/DeepSeek-V3
# DeepSeek 官方配置：
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
AI_API_KEY=sk-你的真实key

# Embedding 向量配置（RAG 语义检索用；SiliconFlow 平台与 AI 对话可共用同一 key）
EMBEDDING_API_KEY=sk-你的真实key
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Embedding API 调用重试（对抗免费版瞬时限流/5xx）——可选，默认 3 次 + 初始 500ms 指数退避
# max-attempts 含首次调用；initial-backoff-ms 为首次失败后等待间隔，每次失败翻倍
EMBEDDING_RETRY_MAX_ATTEMPTS=3
EMBEDDING_RETRY_INITIAL_BACKOFF_MS=500

# Rerank 精排（两级检索第二级，cross-encoder 对粗召回候选重排序，提升 Top-K 质量）
# 可选。默认关闭（RAG_RERANK_ENABLED=false），关闭/未配 key 时检索自动降级为「仅向量粗召回 Top-K」。
# 开启：RAG_RERANK_ENABLED=true 且 RERANK_API_KEY 填 SiliconFlow 真实 key（可与 EMBEDDING_API_KEY 共用同一把）。
RAG_RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_RECALL_N=20   # 粗召回候选数（送进精排）
RAG_RERANK_TOP_K=3       # 精排后返回条数
